datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String
  name         String
  role         String    @default("ChuyenVien") // SuperAdmin, VienTruong, VienPho, TruongPhong, ChuyenVien (also legacy ADMIN, MANAGER, USER)
  avatar       String?
  department   String?
  phone        String?
  affiliations String[]  @default([])
  projects       Project[] @relation("ManagerProjects")
  memberProjects Project[] @relation("ProjectMembers")
  createdProjects  Project[] @relation("CreatorProjects")
  approvedProjects Project[] @relation("ApproverProjects")
  tasks          Task[]    @relation("AssigneeTasks")
  orcid          String?
  scholar        String?
  bio            String?
  researchInterests String[] @default([])
  chemicalProposals ChemicalProposal[] @relation("CreatorProposals")
  approved1Proposals ChemicalProposal[] @relation("Approver1Proposals")
  approved2Proposals ChemicalProposal[] @relation("Approver2Proposals")
  cellProposals          CellProposal[] @relation("CellCreatorProposals")
  cellApproved1Proposals CellProposal[] @relation("CellApprover1Proposals")
  cellApproved2Proposals CellProposal[] @relation("CellApprover2Proposals")
  machineLogs      MachineLog[] @relation("MachineLogCreator")
  laborLogs        LaborLog[]   @relation("UserLaborLogs")
  overtimeRequests        OvertimeRequest[] @relation("OvertimeRequester")
  approved1Overtime       OvertimeRequest[] @relation("Approver1Overtime")
  approved2Overtime       OvertimeRequest[] @relation("Approver2Overtime")
  notifications           Notification[]    @relation("UserNotifications")
  submittedReports        WeeklyReport[]    @relation("ReportedBy")
  receivedReports         WeeklyReport[]    @relation("ReportedTo")
  researchComments        ResearchContentComment[] @relation("UserResearchComments")
  createdAt        DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Project {
  id               Int       @id @default(autoincrement())
  name             String
  nameEn           String?
  code             String?
  topicCode        String?
  projectType      String?
  managementUnit   String?
  hostOrganization String?
  advisor          String?
  executionTime    String?
  budget           String?
  laborBudget      Float?    @default(0)
  generalObjective String?
  description      String?
  status           String    @default("PLANNING") // PLANNING, IN_PROGRESS, COMPLETED, ON_HOLD
  approvalStatus   String    @default("APPROVED") // PENDING, APPROVED, REJECTED
  creatorId        Int?
  creator          User?     @relation("CreatorProjects", fields: [creatorId], references: [id])
  approverId       Int?
  approver         User?     @relation("ApproverProjects", fields: [approverId], references: [id])
  startDate        DateTime?
  endDate          DateTime?
  managerId        Int?
  manager          User?     @relation("ManagerProjects", fields: [managerId], references: [id])
  members          User[]    @relation("ProjectMembers")
  tasks            Task[]
  researchContents ResearchContent[]
  chemicalProposalItems ChemicalProposalItem[]
  cellProposalItems     CellProposalItem[]
  machineLogs          MachineLog[]
  laborLogs            LaborLog[]           @relation("ProjectLaborLogs")
  weeklyReportResults  WeeklyReportResult[] @relation("ProjectWeeklyResults")
  weeklyReportPlans    WeeklyReportPlan[]   @relation("ProjectWeeklyPlans")
  overtimeRequests        OvertimeRequest[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Task {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  status      String   @default("TODO") // TODO, IN_PROGRESS, REVIEW, DONE
  progress    Int      @default(0) // 0 - 100
  projectId   Int
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assigneeId  Int?
  assignee    User?    @relation("AssigneeTasks", fields: [assigneeId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ResearchContent {
  id          Int      @id @default(autoincrement())
  code        String   // VD: ND1, ND2, ND3
  title       String   // VD: Điều tra dân tộc học...
  status      String   @default("Xong 100%") // VD: Xong 100%, Đang thực hiện
  description String?  // VD: Thu thập tri thức bản địa...
  activities  String?  // JSON string: '[{"activity":"...","result":"..."}]'
  projectId   Int
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  comments    ResearchContentComment[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ResearchContentComment {
  id                Int             @id @default(autoincrement())
  content           String
  researchContentId Int
  researchContent   ResearchContent @relation(fields: [researchContentId], references: [id], onDelete: Cascade)
  userId            Int
  user              User            @relation("UserResearchComments", fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model Chemical {
  id             Int                   @id @default(autoincrement())
  code           String                @unique   // Mã HC (VD: HC-001)
  name           String                // Tên hoá chất
  unit           String                // Đơn vị (Lít, Kg, Chai...)
  quantity       Float                 // Số lượng tồn kho hiện tại
  maxQuantity    Float                 // Định mức tối đa (để tính %)
  specification  Float                 // Quy cách (VD: 10 Lít)
  invoicePrice   Float                 // Giá hoá đơn (tổng tiền)
  unitPrice      Float                 // Đơn giá = invoicePrice / specification
  importDate     DateTime              // Ngày nhập kho
  alertThreshold Float     @default(50) // Ngưỡng cảnh báo (%)
  department     String?               // Phòng ban quản lý hoá chất
  location       String?
  note           String?
  transactions   ChemicalTransaction[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model ChemicalTransaction {
  id          Int      @id @default(autoincrement())
  type        String   // IMPORT | EXPORT
  chemicalId  Int
  chemical    Chemical @relation(fields: [chemicalId], references: [id], onDelete: Cascade)
  projectCode String?  // Mã dự án (khi xuất)
  quantity    Float    // Số lượng nhập/xuất
  note        String?
  createdById Int?
  createdAt   DateTime @default(now())
}

model ChemicalProposal {
  id           Int      @id @default(autoincrement())
  status       String   @default("PENDING") // PENDING, PENDING_LEVEL_2, APPROVED, REJECTED
  createdById  Int?
  creator      User?    @relation("CreatorProposals", fields: [createdById], references: [id], onDelete: SetNull)
  approver1Id  Int?
  approver1    User?    @relation("Approver1Proposals", fields: [approver1Id], references: [id], onDelete: SetNull)
  approver2Id  Int?
  approver2    User?    @relation("Approver2Proposals", fields: [approver2Id], references: [id], onDelete: SetNull)
  level1Status String   @default("PENDING") // PENDING, APPROVED, REJECTED
  level2Status String   @default("PENDING") // PENDING, APPROVED, REJECTED
  note         String?
  items        ChemicalProposalItem[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ChemicalProposalItem {
  id           Int      @id @default(autoincrement())
  proposalId   Int
  proposal     ChemicalProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  chemicalName String
  unit         String
  quantity     Float
  phase        String?  // Giai đoạn
  projectId    Int?
  project      Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectCode  String?
}

model Cell {
  id             Int               @id @default(autoincrement())
  code           String            @unique   // Mã quản lý nội bộ (VD: TB-001)
  name           String            // Tên tế bào / chủng tế bào
  ref            String?           // REF - Mã tham chiếu / Catalog number
  lot            String?           // LOT - Số lô
  v              String?           // V - Thể tích / Độ sống / Nồng độ
  p              String?           // P - Passage number / Số lần cấy chuyển
  unit           String            @default("Ống") // Đơn vị
  quantity       Float             // Số lượng tồn kho hiện tại
  maxQuantity    Float             @default(0) // Định mức tối đa
  specification  Float             @default(1) // Quy cách
  invoicePrice   Float             @default(0) // Giá hoá đơn
  unitPrice      Float             @default(0) // Đơn giá
  importDate     DateTime          @default(now()) // Ngày nhập kho
  alertThreshold Float             @default(10) // Ngưỡng cảnh báo (%)
  department     String?           // Phòng ban quản lý
  location       String?           // Vị trí lưu trữ
  note           String?           // Ghi chú thêm
  transactions   CellTransaction[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model CellTransaction {
  id          Int      @id @default(autoincrement())
  type        String   // IMPORT | EXPORT
  cellId      Int
  cell        Cell     @relation(fields: [cellId], references: [id], onDelete: Cascade)
  projectCode String?  // Mã dự án (khi xuất)
  quantity    Float    // Số lượng nhập/xuất
  note        String?
  createdById Int?
  createdAt   DateTime @default(now())
}

model CellProposal {
  id           Int                @id @default(autoincrement())
  status       String             @default("PENDING") // PENDING, PENDING_LEVEL_2, APPROVED, REJECTED
  createdById  Int?
  creator      User?              @relation("CellCreatorProposals", fields: [createdById], references: [id], onDelete: SetNull)
  approver1Id  Int?
  approver1    User?              @relation("CellApprover1Proposals", fields: [approver1Id], references: [id], onDelete: SetNull)
  approver2Id  Int?
  approver2    User?              @relation("CellApprover2Proposals", fields: [approver2Id], references: [id], onDelete: SetNull)
  level1Status String             @default("PENDING") // PENDING, APPROVED, REJECTED
  level2Status String             @default("PENDING") // PENDING, APPROVED, REJECTED
  note         String?
  items        CellProposalItem[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model CellProposalItem {
  id          Int          @id @default(autoincrement())
  proposalId  Int
  proposal    CellProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  cellName    String
  ref         String?
  lot         String?
  v           String?
  p           String?
  unit        String       @default("Ống")
  quantity    Float
  phase       String?      // Giai đoạn
  projectId   Int?
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectCode String?
}

model Machine {
  id             Int          @id @default(autoincrement())
  code           String       @unique // Mã tài sản
  name           String       // Tên tài sản
  category       String?      // Phân loại
  department     String       // Đơn vị sử dụng
  characteristics String?     // Đặc điểm
  status         String       @default("IN_USE") // IN_USE, NOT_IN_USE
  logs           MachineLog[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model MachineLog {
  id          Int      @id @default(autoincrement())
  machineId   Int
  machine     Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  date        DateTime // Ngày tiêu hao
  minutes     Int      // Số phút tiêu hao
  projectId   Int?     // Dự án sử dụng máy
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdById Int?
  creator     User?    @relation("MachineLogCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
}

model LaborLog {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation("UserLaborLogs", fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime // Ngày ghi nhận
  adminHours  Float    @default(0) // Giờ hành chính
  proHours    Float    @default(0) // Giờ chuyên môn
  cleanHours  Float    @default(0) // Giờ dọn dẹp
  projectId   Int?     // Dự án liên quan
  note        String?  // Công việc khác / Ghi chú
  project     Project? @relation("ProjectLaborLogs", fields: [projectId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OvertimeRequest {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation("OvertimeRequester", fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime
  hours        Float
  reason       String
  projectId    Int?
  project      Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  approver1Id  Int?
  approver1    User?    @relation("Approver1Overtime", fields: [approver1Id], references: [id], onDelete: SetNull)
  approver2Id  Int?
  approver2    User?    @relation("Approver2Overtime", fields: [approver2Id], references: [id], onDelete: SetNull)
  status       String   @default("PENDING") // PENDING, PENDING_LEVEL_2, APPROVED, REJECTED
  level1Status String   @default("PENDING") // PENDING, APPROVED, REJECTED
  level2Status String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  type      String   // 'CHEMICAL_WARNING', 'OVERTIME_PENDING', 'OVERTIME_APPROVED', 'OVERTIME_REJECTED', 'PROPOSAL_PENDING', 'PROPOSAL_RESULT'
  link      String?  // Optional link
  createdAt DateTime @default(now())
}

model WeeklyReport {
  id          Int                  @id @default(autoincrement())
  reporterId  Int
  reporter    User                 @relation("ReportedBy", fields: [reporterId], references: [id])
  recipientId Int
  recipient   User                 @relation("ReportedTo", fields: [recipientId], references: [id])
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  results     WeeklyReportResult[]
  plans       WeeklyReportPlan[]
}

model WeeklyReportResult {
  id          Int          @id @default(autoincrement())
  reportId    Int
  report      WeeklyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  projectId   Int?
  project     Project?     @relation("ProjectWeeklyResults", fields: [projectId], references: [id], onDelete: SetNull)
  description String?
  fileUrl     String?
  fileName    String?
  fileData    String?      // Base64 backup for files < 10MB
}

model WeeklyReportPlan {
  id          Int          @id @default(autoincrement())
  reportId    Int
  report      WeeklyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  projectId   Int?
  project     Project?     @relation("ProjectWeeklyPlans", fields: [projectId], references: [id], onDelete: SetNull)
  customTitle String?      // "Khác" or task name
  description String?
}
